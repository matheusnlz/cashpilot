Options -Indexes

# Bloqueia arquivos internos e artefatos de desenvolvimento.
<FilesMatch "(?i)(^\.env|^\.git|\.sql$|\.log$|\.ini$|\.bak$|\.old$|\.dist$|\.md$|^Dockerfile$|^composer\.(json|lock)$|^requirements\.txt$|^\.gitignore$|^\.dockerignore$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
