# CashPilot 14.10 - produção
CASHPILOT_ENV=production
CASHPILOT_SECURITY_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# Banco - nomes genéricos
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Railway também é aceito diretamente:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLDATABASE=
# MYSQLUSER=
# MYSQLPASSWORD=

CASHPILOT_PYTHON_PATH=/opt/cashpilot-venv/bin/python

BREVO_API_KEY=
CASHMAIL_FROM_EMAIL=
CASHMAIL_FROM_NAME=CashPilot

GOOGLE_CLIENT_ID=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
