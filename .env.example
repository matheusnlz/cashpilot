# CashPilot - modelo de configuração local. Na Railway, use Variables.
# Copie este arquivo para .env apenas no ambiente local e nunca envie a cópia
# preenchida ao Git, ao ZIP de distribuição ou a terceiros.
CASHPILOT_ENV=development
CASHPILOT_SECURITY_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres
CASHPILOT_PRIVACY_EMAIL=
# false desativa novas chamadas Groq, inclusive diagnóstico administrativo.
CASHPILOT_IA_EXTERNAL_ENABLED=true

# Banco - nomes genéricos
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Railway também é aceito diretamente:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLDATABASE=
# MYSQLUSER=
# MYSQLPASSWORD=

# Vazio usa python no Windows e python3 no Linux.
CASHPILOT_PYTHON_PATH=

BREVO_API_KEY=
CASHMAIL_FROM_EMAIL=
CASHMAIL_FROM_NAME=CashPilot

GOOGLE_CLIENT_ID=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b


# Pluggy / Open Finance
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_INCLUDE_SANDBOX=true
# URL pública sem barra final, usada pelo webhook no Railway.
CASHPILOT_PUBLIC_URL=
# Gere um valor aleatório longo e configure o mesmo valor na Pluggy no cabeçalho
# X-CashPilot-Webhook-Token. Nunca coloque o token na URL.
PLUGGY_WEBHOOK_TOKEN=
